# ───────────────────────────────────────────────────────────────────
# Tonkl Node — Docker build
#
# Usage:
#   docker compose up --build
# ───────────────────────────────────────────────────────────────────

FROM rust:1.89-bookworm AS builder

WORKDIR /build

# Copy source
COPY tonkl-prover/ tonkl-prover/
COPY tonkl-node/ tonkl-node/

# Build release binary
# TONKL_ALLOW_UNCHECKED_CIRCUIT_HASH: the node verifies proofs via VK files,
# it does not generate proofs, so the circuit hash bake-in is not needed.
ENV TONKL_ALLOW_UNCHECKED_CIRCUIT_HASH=1
RUN cd tonkl-node && cargo build --release --locked

# ─── Runtime stage ────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tonkl

# Copy node binary
COPY --from=builder /build/tonkl-node/target/release/tonkl-node /usr/local/bin/tonkl-node

# Copy verification keys
COPY vks/ /tonkl/vks/

RUN mkdir -p /tonkl/data

EXPOSE 9100

ENTRYPOINT ["tonkl-node"]
CMD ["run", "--bind", "0.0.0.0", "--port", "9100", "--data-dir", "/tonkl/data", \
     "--vk-dir", "/tonkl/vks"]
